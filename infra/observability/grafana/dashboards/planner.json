{
  "uid": "planner-operations",
  "title": "Adaptive Planner operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(planner_api_requests_count[1m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "API p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(planner_stage_duration_seconds_bucket{stage=\"api.request\"}[5m])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "Database reachable",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "planner_db_reachable",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Pool checked out",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "planner_db_pool_in_use",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "Jobs by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "planner_jobs_by_state",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "Oldest queue age seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "planner_queue_oldest_age_seconds",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "title": "Expired leases",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "planner_jobs_expired_leases",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "Solver outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(planner_jobs_results_count{stage=\"solve\"}[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "title": "Calendar lag seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "planner_calendar_lag_seconds",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "title": "Calendar conflicts / operations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "planner_calendar_conflicts or planner_calendar_operations",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 11,
      "title": "Model outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "planner_model_proposals",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 12,
      "title": "Model spend (micro USD)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "planner-prometheus"
      },
      "targets": [
        {
          "expr": "planner_model_spend_microusd or planner_model_reserved_microusd",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      }
    }
  ]
}