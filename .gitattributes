* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.png binary

# Frozen evaluation manifests hash exact bytes; preserve their original bytes.
services/planner/src/planner/ai/provider.py -text whitespace=cr-at-eol
services/planner/src/planner/ai/interpret.py -text whitespace=cr-at-eol
services/planner/src/planner/ai/schema.py -text whitespace=cr-at-eol
services/planner/src/planner/ai/prompt.py -text whitespace=cr-at-eol
evals/data/author.py -text whitespace=cr-at-eol
evals/score/metrics.py -text whitespace=cr-at-eol
evals/run/evaluate.py -text whitespace=cr-at-eol
evals/data/dev.jsonl -text whitespace=cr-at-eol
evals/data/validation.jsonl -text whitespace=cr-at-eol
evals/data/test.jsonl -text whitespace=cr-at-eol
evals/data/manifest.json -text whitespace=cr-at-eol

# Measurement manifests are immutable byte-hashed inputs.
benchmarks/manifests/*.json -text whitespace=cr-at-eol
benchmarks/artifacts/*.zip binary

# Preserve byte-hashed experiment artifacts across Windows checkouts.
training/artifacts/** -text whitespace=cr-at-eol
docs/evidence/raw/ml*.json -text whitespace=cr-at-eol

docs/evidence/raw/final-*.txt -text whitespace=cr-at-eol
docs/evidence/raw/task-18-image-scan.json -text whitespace=cr-at-eol
docs/evidence/raw/task-18-local-rehearsal.json -text whitespace=cr-at-eol
# Raw stdout retains terminal whitespace; source code checks remain unchanged.
docs/evidence/raw/*.txt whitespace=cr-at-eol,-blank-at-eof,-blank-at-eol
